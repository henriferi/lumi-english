# Copy to .env (never commit .env). Read by docker compose and by the Spring Boot backend.

# OpenAI — create a project key and set a spending limit in the dashboard.
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional tuning (defaults in backend application.yml):
# OPENAI_MAX_COMPLETION_TOKENS=800
# RAG_TOP_K=4
# RAG_SIMILARITY_THRESHOLD=0.2

# PostgreSQL (docker compose)
POSTGRES_DB=lumi
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi
# 5433 avoids clashing with a PostgreSQL installed locally on 5432
POSTGRES_PORT=5433
